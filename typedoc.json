{
  "$schema": "https://typedoc-plugin-markdown.org/schema.json",
  "entryPoints": ["src/index.ts"],
  "tsconfig": "tsconfig.src.json",
  "plugin": ["typedoc-plugin-markdown", "typedoc-plugin-missing-exports"],
  "placeInternalsInOwningModule": true,
  "out": "node_modules/.cache/typedoc",
  "router": "module",
  "readme": "none",
  "excludeExternals": true,
  "disableSources": true,
  "groupOrder": ["Components", "Hooks", "Render Functions", "Context", "Other", "Types", "*"],
  "sort": ["source-order"],
  "notRenderedTags": [
    "@showCategories",
    "@showGroups",
    "@hideCategories",
    "@hideGroups",
    "@disableGroups",
    "@expand",
    "@preventExpand",
    "@expandType",
    "@summary",
    "@group",
    "@groupDescription",
    "@category",
    "@categoryDescription",
    "@sortStrategy"
  ],
  "hidePageHeader": true,
  "hidePageTitle": true,
  "hideBreadcrumbs": true,
  "useCodeBlocks": true,
  "expandParameters": true,
  "parametersFormat": "none",
  "typeDeclarationVisibility": "compact",
  "useHTMLAnchors": true
}
